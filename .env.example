# Environment. Copy to `.env` for Monad Testnet and to `.env.mainnet` for Monad Mainnet.
# Both are gitignored. Nothing in this repository prints or logs a value from them.

# --- network: every script and gate reads the deployment record this names ---
MONAD_CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# --- EIP-712 domain name the hub is deployed with: the product name a signer sees ---
EIP712_NAME=Weir

# --- Testnet redeploys only (optional): build the new hub on the test AUSD and savings vault
# already deployed instead of new ones, so the savings router and every payer's balance carry over.
# Both or neither; unset or zero deploys new ones. script/Deploy.s.sol checks each is the stand-in
# it claims to be before deploying anything, and refuses them on Mainnet.
# REUSE_TEST_STABLECOIN=0xf3066908dABe11f2e72F6887D9943eeb621a0Eb9
# REUSE_TEST_SAVINGS_VAULT=0xe0cd535d298DAd5e228486a79A21176349825B8d

# --- keys: one per role, never shared between roles ---
# Deploys the contracts. Holds no role afterwards: the contracts have no owner.
DEPLOYER_PRIVATE_KEY=0x<64-hex>
DEPLOYER_ADDRESS=0x<address>
# Submits signed installs and lifecycle actions so payers never need gas.
RELAYER_PRIVATE_KEY=0x<64-hex>
RELAYER_ADDRESS=0x<address>
# Sends charges. Permissionless: any funded key works.
KEEPER_PRIVATE_KEY=0x<64-hex>
KEEPER_ADDRESS=0x<address>

# --- contract verification (optional): an Etherscan v2 key verifies on Monadscan ---
ETHERSCAN_API_KEY=<etherscan-api-key>

# --- indexing (optional): Envio HyperSync for fast log reads ---
HYPERSYNC_URL=https://monad-testnet.hypersync.xyz
HYPERSYNC_API_TOKEN=<token>

# --- API and relayer (apps/api) ---
# Optional: the Envio HyperIndex database (apps/envio-indexer) the business dashboard's revenue
# and the network stats read. One index holds every network.
# ENVIO_DATABASE_URL=postgres://localhost:5432/weir_envio
# In `.env.mainnet`: a database of its own (weir_mainnet) and API_PORT=8792, so both networks run side by side.
DATABASE_URL=postgres://localhost:5432/weir
API_PORT=8790
# Browser origins allowed to call the API, comma separated.
API_ALLOWED_ORIGINS=http://localhost:5173
# Privy, for merchant sign-in. Merchant routes answer 503 until both are set.
PRIVY_APP_ID=<privy-app-id>
PRIVY_APP_SECRET=<privy-app-secret>
# Local development only: accept `Authorization: Dev <address>` as a merchant. Never set in production.
WEIR_DEV_AUTH=0
# Testnet faucet: base units of test AUSD per request.
FAUCET_AMOUNT=100000000
# Push reminders: a VAPID key pair (P-256, base64url) and a contact for push services, a mailto:
# address or an https URL. All three or none; without them there are no reminders.
# Generate a pair with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=<base64url-public-key>
VAPID_PRIVATE_KEY=<base64url-private-key>
VAPID_SUBJECT=mailto:<contact>

# --- keeper (apps/keeper) ---
KEEPER_INTERVAL_MS=5000
KEEPER_BATCH_SIZE=50
# Charge a stream once it has accrued this many base units, or once it is this old, whichever first.
KEEPER_STREAM_MIN_CHARGE=10000
KEEPER_STREAM_MAX_AGE_SECONDS=3600
KEEPER_CURSOR_PATH=.state/keeper-cursor.json
# 8793 in `.env.mainnet`, with KEEPER_CURSOR_PATH=.state/keeper-cursor.mainnet.json.
KEEPER_PORT=8791
# Optional keeper tuning. Monad bills the gas limit, so the margin over each estimate stays tight.
KEEPER_HOST=127.0.0.1
KEEPER_GAS_MARGIN_BPS=500
KEEPER_GAS_MARGIN_GAS=5000
KEEPER_GAS_FLOOR=50000
KEEPER_GAS_CEILING=30000000

# --- web app (apps/web/.env.local, all optional) ---
# The app runs on both networks and a visitor switches between them; this is where it starts.
# VITE_CHAIN_ID=143
# Each network's API. In development the dev server proxies /testnet to :8790 and /mainnet to :8792.
# VITE_API_URL_TESTNET=https://<testnet-api-host>
# VITE_API_URL_MAINNET=https://<mainnet-api-host>
# The plan "Try a checkout" opens, per network (plans live in each network's API).
# VITE_DEMO_PLAN_ID=<testnet-plan-id>
# VITE_DEMO_PLAN_ID_MAINNET=<mainnet-plan-id>
# VITE_PRIVY_APP_ID=<privy-app-id>
# VITE_AURORA_API_KEY=<aurora-key>
# VITE_SITE_URL=http://localhost:3000
