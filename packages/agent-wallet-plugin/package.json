{
  "name": "@weir/agent-wallet-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Weir for the MetaMask Agent Wallet CLI: an agent subscribes to and manages paid services on Monad by signing, with no gas",
  "license": "MIT",
  "keywords": [
    "oclif-plugin",
    "metamask",
    "agent-wallet",
    "monad",
    "direct-debit",
    "subscriptions"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "mm:link": "node scripts/link.mjs"
  },
  "oclif": {
    "bin": "mm",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "topics": {
      "weir": {
        "description": "Direct debit on Monad: subscribe to paid services and manage them by signing, with no gas"
      }
    }
  },
  "mm": {
    "schemaVersion": 1,
    "minCliVersion": ">=7.0.0",
    "capabilities": [],
    "commands": [
      {
        "id": "weir:plan",
        "capabilities": [],
        "dataAccess": [],
        "targetChains": [143, 10143]
      },
      {
        "id": "weir:list",
        "capabilities": ["wallet-read"],
        "dataAccess": ["accounts"],
        "targetChains": [143, 10143]
      },
      {
        "id": "weir:faucet",
        "capabilities": ["wallet-read"],
        "dataAccess": ["accounts"],
        "targetChains": [10143]
      },
      {
        "id": "weir:subscribe",
        "capabilities": ["wallet-read", "wallet-submit"],
        "dataAccess": ["accounts"],
        "targetChains": [143, 10143]
      },
      {
        "id": "weir:stop",
        "capabilities": ["wallet-read", "wallet-submit"],
        "dataAccess": ["accounts"],
        "targetChains": [143, 10143]
      },
      {
        "id": "weir:pause",
        "capabilities": ["wallet-read", "wallet-submit"],
        "dataAccess": ["accounts"],
        "targetChains": [143, 10143]
      },
      {
        "id": "weir:resume",
        "capabilities": ["wallet-read", "wallet-submit"],
        "dataAccess": ["accounts"],
        "targetChains": [143, 10143]
      },
      {
        "id": "weir:savings",
        "capabilities": ["wallet-read", "wallet-submit"],
        "dataAccess": ["accounts"],
        "targetChains": [143, 10143]
      }
    ]
  },
  "peerDependencies": {
    "@metamask/agent-wallet": ">=7.0.0"
  },
  "dependencies": {
    "@weir/shared": "workspace:*",
    "viem": "2.45.3"
  },
  "devDependencies": {
    "@metamask/agent-wallet": "7.0.0",
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  }
}
