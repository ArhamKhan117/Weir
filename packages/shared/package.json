{
  "name": "@weir/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Shared types, Monad networks and assets, EIP-712 typed data, config loading and contract ABIs",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fs": {
      "types": "./dist/fs.d.ts",
      "default": "./dist/fs.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "gen:abi": "tsx scripts/generate-abi.ts"
  },
  "dependencies": {
    "viem": "2.45.3"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
